Patch for construct-os-v2/agent/index.ts
==========================================

Adds a call to the Treasury Agent's webhook right after the Inspector
Agent approves a milestone. Reads the milestone's real amountHeld from
ConstructionEscrow's public `milestones` mapping getter — confirmed
against the actual Milestone struct in contracts/ConstructionEscrow.sol:

    struct Milestone {
        address contractorAgent;
        uint256 amountHeld;
        bytes32 proofHash;
        uint8   status;
        uint256 submittedAt;
    }

--- a/agent/index.ts
+++ b/agent/index.ts
@@ -1,8 +1,10 @@
+import { ethers }             from 'ethers';
 import { startListener }      from './listener/contractListener';
 import { startQueue }         from './queue/jobQueue';
 import { verificationEngine } from './verification/verificationEngine';
 import { decisionEngine }     from './decision/decisionEngine';
 import { arcSettler }         from './settlement/arcSettler';
 import { reputationLedger }   from './reputation/reputationLedger';
 import { IPFSUnreachableError } from '../shared/errors';
+import { ARC_RPC, ESCROW_ADDRESS } from '../shared/constants';
+
+const TREASURY_AGENT_URL = process.env.TREASURY_AGENT_URL || 'http://localhost:4001';
+
+const escrowReadAbi = [
+  'function milestones(bytes32) view returns (address contractorAgent, uint256 amountHeld, bytes32 proofHash, uint8 status, uint256 submittedAt)',
+];
+
+async function notifyTreasuryAgent(milestoneId: string, contractorAgent: string) {
+  try {
+    const provider = new ethers.JsonRpcProvider(ARC_RPC);
+    const escrow    = new ethers.Contract(ESCROW_ADDRESS, escrowReadAbi, provider);
+    const id        = milestoneId.startsWith('0x') ? milestoneId : `0x${milestoneId}`;
+    const milestone = await escrow.milestones(id);
+    const amountUsdc = Number(ethers.formatUnits(milestone.amountHeld, 6)); // USDC = 6 decimals
+
+    const res = await fetch(`${TREASURY_AGENT_URL}/verified-milestone`, {
+      method:  'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body:    JSON.stringify({
+        milestoneId,
+        contractorAddress: contractorAgent,
+        amount: amountUsdc,
+      }),
+    });
+
+    const body = await res.json();
+    console.log(`[treasury-notify] ${res.status}`, body);
+  } catch (err) {
+    console.warn(`[treasury-notify] failed: ${err instanceof Error ? err.message : err}`);
+  }
+}
 
